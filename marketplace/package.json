{
  "name": "khmer-craft",
  "version": "1.0.0",
  "description": "KhmerCraft — multi-vendor marketplace for Cambodian handicrafts",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --prefix apps/web start",
    "dev:web-preview": "npm --prefix apps/web run start:seller",
    "dev:api": "npm --prefix apps/api run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}