{
  "name": "ecommerce-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "node scripts/quality/check-js.js . test --ignore node_modules --ignore migrations",
    "typecheck": "node scripts/quality/check-js.js . test --ignore node_modules --ignore migrations",
    "test:unit": "node --test test/security/**/*.test.js",
    "test:integration": "node --test test/integration/**/*.test.js",
    "test:security": "npm run test:unit",
    "test": "npm run test:unit && npm run test:integration",
    "build": "node --check server.js && node --check app.js",
    "secrets:scan": "node scripts/quality/secret-scan.js",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run secrets:scan",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:security": "node --test test/security/**/*.test.js",
    "security:migrate-payment-configs": "node scripts/encryptPaymentConfigs.js",
    "db:migrate": "node migrations/runner.js migrate",
    "db:migrate:verify": "node migrations/runner.js verify",
    "db:audit-stores": "node scripts/auditStoreMapping.js",
    "db:smoke-catalog": "node scripts/smokeStoreCatalog.js",
    "db:smoke-marketplace-checkout": "node scripts/smokeMarketplaceCheckout.js",
    "db:audit-marketplace-cod": "node scripts/auditMarketplaceCod.js",
    "db:audit-cod": "node scripts/auditMarketplaceCod.js",
    "db:export-cutover-projection": "node scripts/exportCutoverProjection.js",
    "db:seed-marketplace-mocks": "node scripts/seedMarketplaceMocks.js",
    "db:seed": "node scripts/seed.js"
  },
