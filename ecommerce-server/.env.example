NODE_ENV=
PORT=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
SESSION_SECRET=
RENTIFY_API_URL=
ECOMMERCE_API_URL=
AUTH_URL=
MERCHANT_DASHBOARD_URL=
MARKETING_URL=
STOREFRONT_ORIGIN=
CORS_ALLOWED_ORIGINS=
SERVICE_TO_SERVICE_TOKEN=
MARKETPLACE_COD_CHECKOUT_ENABLED=false
STOREFRONT_COD_CHECKOUT_ENABLED=false
HOSTED_STOREFRONT_DOMAIN=rentifystore.shop
# Development only (ignored in production): allow http://<subdomain>.localhost:<port>.
HOSTED_STOREFRONT_DEV_PORT=
PAYMENT_CONFIG_ENCRYPTION_KEY=
BAKONG_API_URL=
ABA_API_URL=
# ABA PayWay KHQR (RETIRED for Release 1 checkout per DEC-029; CutLuy is the sole online payment path).
# Kept inactive for possible future use; leave false/unset. PAYWAY_ENABLED=true is prohibited in production/staging.
PAYWAY_ENABLED=false
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Must be publicly reachable for ABA's webhook; on localhost the payment page polls instead.
PAYWAY_CALLBACK_URL=
# Local only: fake ABA gateway with a "Mark as paid" button, for when sandbox keys are unavailable.
# Ignored when NODE_ENV=production.
PAYWAY_MOCK=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=

# Shared secret for service-to-service calls between Core and Commerce (must match on both)
INTERNAL_SERVICE_SECRET=

# CutLuy Online Payment (DEC-029: CutLuy is the sole online KHQR payment path; ABA PayWay is retired)
CUTLUY_ENABLED=true
CUTLUY_API_BASE_URL=https://cutluy.com
# Unpaid KHQR order timeout in minutes before auto-cancellation and inventory release (DEC-029: 15 minutes)
KHQR_UNPAID_ORDER_TIMEOUT_MINUTES=15
