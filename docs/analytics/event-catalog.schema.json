{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rentify.local/schemas/analytics-event-catalog.json",
  "type": "object",
  "required": ["catalogVersion", "effectiveDate", "privacy", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "effectiveDate": { "type": "string", "format": "date" },
    "privacy": {
      "type": "object",
      "required": ["classification", "prohibitedProperties", "rules"],
      "additionalProperties": false,
      "properties": {
        "classification": { "type": "string" },
        "prohibitedProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "schemaVersion", "owner", "category", "source", "requiredProperties", "allowedProperties"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "owner": { "enum": ["core", "commerce"] },
          "category": { "type": "string" },
          "source": { "enum": ["browser", "authoritative"] },
          "requiredProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "allowedProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "allowedMeasures": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
