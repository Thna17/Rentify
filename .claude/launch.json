{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketplace",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "marketplace-frontend",
        "start"
      ],
      "port": 4500
    },
    {
      "name": "marketing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "rentify-frontend",
        "run",
        "dev:marketing",
        "--",
        "--port",
        "4210",
        "--strictPort"
      ],
      "port": 4210
    },
    {
      "name": "pos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "rentify-frontend",
        "run",
        "dev:pos"
      ],
      "port": 4450
    }
  ]
}
