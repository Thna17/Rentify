    "test:shared-ui": "vitest run --mode development --config libs/shared/vite.config.ts",
    "test:template-1": "vitest run --mode development --config apps/templates/ecommerce/ecommerce-template-1/vite.config.ts",
    "test:unit": "npm run test:shared-ui && npm run test:template-1",
    "test:integration": "node --test e2e/**/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "secrets:scan": "node tools/secret-scan.mjs",
