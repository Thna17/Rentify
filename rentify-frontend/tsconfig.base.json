{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@rentify/apis": ["./libs/apis/src/index.jsx"],
      "@rentify/apis/*": ["./libs/apis/src/store/*"],
      "@rentify/cart/*": ["./libs/cart/src/*"],
      "@rentify/checkout/*": ["./libs/checkout/src/*"],
      "@rentify/customer-order/*": ["./libs/customer-order/src/*"],
      "@rentify/features": ["./libs/features/src/index.ts"],
      "@rentify/features/*": ["./libs/features/src/*"],
      "@rentify/libs": ["./libs/src/index.ts"],
      "@rentify/not-found/*": ["./libs/not-found/src/*"],
      "@rentify/order": ["./libs/features/src/order/index.js"],
      "@rentify/order-confirmation/*": ["./libs/order-confirmation/src/*"],
      "@rentify/order-management/*": ["./libs/order-management/src/*"],
      "@rentify/order/*": ["./libs/features/src/order/*"],
      "@rentify/product": ["./libs/features/src/product/index.js"],
      "@rentify/product-catalog/*": ["./libs/product-catalog/src/*"],
      "@rentify/product-form/*": ["./libs/product-form/src/*"],
      "@rentify/product/*": ["./libs/features/src/product/*"],
      "@rentify/profile/*": ["./libs/profile/src/*"],
      "@rentify/shared": ["./libs/shared/src/index.ts"],
      "@rentify/shared/*": ["./libs/shared/src/*"],
      "@rentify/staff-accept/*": ["./libs/staff-accept/src/*"],
      "@rentify/state": ["./libs/state/src/index.ts"],
      "@rentify/utils": ["./libs/utils/src/index.jsx"],
      "@rentify/utils/*": ["./libs/utils/src/*"],
      "@rentify/storefront": ["./libs/storefront/src/index.ts"],
      "@rentify/storefront/*": ["./libs/storefront/src/*"],
      "@rentify/website": ["./libs/features/src/website/index.js"],
      "@rentify/website/*": ["./libs/features/src/website/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
